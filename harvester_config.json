{
  "api_url": "http://localhost:8000",
  "watch_dir": "C:/Games/MyIndieGame/cache/logs",
  "game_id": "my_indie_v1",
  "player_id": "session_auto",
  "batch_size": 15,
  "flush_interval_sec": 4,
  "default_event": "game_log",
  "parsers": [
    {
      "type": "regex",
      "pattern": "\\[METRIC\\]\\s+(\\w+)\\s+player=(\\S+)\\s+data=(\\{.*\\})",
      "extract": {
        "event_type": 1,
        "player_id": 2,
        "raw_data": 3
      }
    },
    {
      "type": "regex",
      "pattern": "Player\\s+(\\S+)\\s+triggered\\s+(\\w+)\\s+with\\s+score=(\\d+)",
      "extract": {
        "player_id": 1,
        "event_type": 2,
        "score": 3
      }
    }
  ]
}
